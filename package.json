{
  "name": "weci-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WeCi 官方网站 —— Vue 3 + Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "check": "node scripts/check-slugs.mjs && node scripts/check-anchors.mjs && node scripts/check-toc.mjs",
    "build:gh": "VITE_BASE=/weci-web/ vite build",
    "deploy": "bash scripts/deploy-gh-pages.sh",
    "deploy:dry": "bash scripts/deploy-gh-pages.sh --dry-run"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
